{
    "version": 4,
    "configurePresets": [
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "intel-llvm",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "msvc-17",
            "hidden": true,
            "generator": "Visual Studio 15 2017",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "msvc-22",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "inherits": [
                "msvc-17"
            ]
        },
        {
            "name": "msvc-26",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "inherits": [
                "msvc-17"
            ]
        },
        {
            "name": "msvc-x86",
            "hidden": true,
            "architecture": "Win32",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "msvc-x64",
            "hidden": true,
            "architecture": "x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [ "Windows" ]
                }
            }
        },
        {
            "name": "integration",
            "hidden": true,
            "description": "Short build folders and one download folder shared by all presets",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "FETCHCONTENT_EXTERNALS_DIR": "${sourceDir}/build/_ext"
            }
        },
        {
            "name": "msvc22",
            "displayName": "[MSVC 22] x64",
            "inherits": [
                "integration",
                "msvc-22",
                "msvc-x64"
            ]
        },
        {
            "name": "msvc26",
            "displayName": "[MSVC 26] x64",
            "inherits": [
                "integration",
                "msvc-26",
                "msvc-x64"
            ]
        },
        {
            "name": "gcc-debug",
            "displayName": "[GCC] Debug",
            "inherits": [
                "integration",
                "debug",
                "gcc",
                "ninja"
            ]
        },
        {
            "name": "gcc-release",
            "displayName": "[GCC] Release",
            "inherits": [
                "integration",
                "release",
                "gcc",
                "ninja"
            ]
        },
        {
            "name": "clang-debug",
            "displayName": "[Clang] Debug",
            "inherits": [
                "integration",
                "debug",
                "clang",
                "ninja"
            ]
        },
        {
            "name": "clang-release",
            "displayName": "[Clang] Release",
            "inherits": [
                "integration",
                "release",
                "clang",
                "ninja"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "test-apps",
            "hidden": true,
            "description": "Builds the integration test apps and everything they link",
            "targets": [
                "test_ref_modules",
                "test_device_modules",
                "test_device_modules_streaming"
            ]
        },
        {
            "name": "msvc22-release",
            "displayName": "[MSVC 22] x64 - Release",
            "configurePreset": "msvc22",
            "configuration": "Release",
            "inherits": "test-apps"
        },
        {
            "name": "msvc22-debug",
            "displayName": "[MSVC 22] x64 - Debug",
            "configurePreset": "msvc22",
            "configuration": "Debug",
            "inherits": "test-apps"
        },
        {
            "name": "msvc26-release",
            "displayName": "[MSVC 26] x64 - Release",
            "configurePreset": "msvc26",
            "configuration": "Release",
            "inherits": "test-apps"
        },
        {
            "name": "msvc26-debug",
            "displayName": "[MSVC 26] x64 - Debug",
            "configurePreset": "msvc26",
            "configuration": "Debug",
            "inherits": "test-apps"
        },
        {
            "name": "gcc-debug",
            "displayName": "[GCC] Debug",
            "configurePreset": "gcc-debug",
            "inherits": "test-apps"
        },
        {
            "name": "gcc-release",
            "displayName": "[GCC] Release",
            "configurePreset": "gcc-release",
            "inherits": "test-apps"
        },
        {
            "name": "clang-debug",
            "displayName": "[Clang] Debug",
            "configurePreset": "clang-debug",
            "inherits": "test-apps"
        },
        {
            "name": "clang-release",
            "displayName": "[Clang] Release",
            "configurePreset": "clang-release",
            "inherits": "test-apps"
        }
    ],
    "testPresets": [
        {
            "name": "run_tests",
            "hidden": true,
            "description": "Run all integration tests; RESOURCE_LOCK keeps port and mDNS users apart, so -j is safe",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc22-release",
            "displayName": "[MSVC 22] x64 - Release",
            "configurePreset": "msvc22",
            "configuration": "Release",
            "inherits": "run_tests"
        },
        {
            "name": "msvc22-debug",
            "displayName": "[MSVC 22] x64 - Debug",
            "configurePreset": "msvc22",
            "configuration": "Debug",
            "inherits": "run_tests"
        },
        {
            "name": "msvc26-release",
            "displayName": "[MSVC 26] x64 - Release",
            "configurePreset": "msvc26",
            "configuration": "Release",
            "inherits": "run_tests"
        },
        {
            "name": "msvc26-debug",
            "displayName": "[MSVC 26] x64 - Debug",
            "configurePreset": "msvc26",
            "configuration": "Debug",
            "inherits": "run_tests"
        },
        {
            "name": "gcc-debug",
            "displayName": "[GCC] Debug",
            "configurePreset": "gcc-debug",
            "inherits": "run_tests"
        },
        {
            "name": "gcc-release",
            "displayName": "[GCC] Release",
            "configurePreset": "gcc-release",
            "inherits": "run_tests"
        },
        {
            "name": "clang-debug",
            "displayName": "[Clang] Debug",
            "configurePreset": "clang-debug",
            "inherits": "run_tests"
        },
        {
            "name": "clang-release",
            "displayName": "[Clang] Release",
            "configurePreset": "clang-release",
            "inherits": "run_tests"
        }
    ]
}
